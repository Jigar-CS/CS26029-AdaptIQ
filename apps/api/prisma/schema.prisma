datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  FACULTY
  COUNSELLOR
  HOD
  HEAD
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTIPLE
  TRUE_FALSE
  NUMERIC
  SHORT_ANSWER
  CODING
}

enum QuestionStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum LearningHistoryReason {
  PRACTICE_ATTEMPT
  TEST_RESULT
  REASSESSMENT
  MANUAL_RECALCULATION
}

enum ResourceType {
  LECTURE_SLIDE
  VIDEO_WALKTHROUGH
  REFERENCE_TEXT
  CODE_SANDBOX
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum SocraticActionType {
  EXPLAIN_SIMPLY
  REAL_WORLD_EXAMPLE
  ASK_FOLLOW_UP
  PRACTICE_SIMILAR
  SOCRATIC_PROMPT
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  role          UserRole        @default(STUDENT)
  status        UserStatus      @default(ACTIVE)
  emailVerified Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lastLoginAt   DateTime?

  studentProfile   StudentProfile?
  facultyProfile   FacultyProfile?
  authorizedRecord AuthorizedStudent?

  @@index([email])
  @@index([role])
}

model Institute {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id          String      @id @default(uuid())
  instituteId String
  institute   Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name        String
  code        String
  programs    Program[]
  courses     Course[]
  programOutcomes ProgramOutcome[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([instituteId, code])
}

model Program {
  id           String             @id @default(uuid())
  departmentId String
  department   Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  code         String
  students     AuthorizedStudent[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([departmentId, code])
}

model Course {
  id           String            @id @default(uuid())
  code         String            @unique
  name         String
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semester     Int
  topics       Topic[]
  questions    Question[]
  practiceSessions PracticeSession[]
  assessments  Assessment[]
  facultyProfiles FacultyProfile[]
  documents    CourseDocument[]
  courseOutcomes CourseOutcome[]
  codingProblems CodingProblem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Topic {
  id            String            @id @default(uuid())
  courseId      String
  course        Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  parentTopicId String?
  parentTopic   Topic?            @relation("SubTopics", fields: [parentTopicId], references: [id], onDelete: SetNull)
  subTopics     Topic[]           @relation("SubTopics")
  questions     Question[]
  skillMasteries SkillMastery[]
  learningHistories LearningHistory[]
  learningResources LearningResource[]
  aiConversations   AIConversation[]
  misconceptions    Misconception[]
  spacedSchedules   SpacedRepetitionSchedule[]
  aiGeneratedQuestions AIGeneratedQuestion[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([courseId, slug])
}

model AuthorizedStudent {
  id               String          @id @default(uuid())
  enrollmentNumber String          @unique
  name             String
  email            String          @unique
  institute        String
  department       String
  programId        String?
  program          Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  programName      String
  semester         Int
  division         String
  graduationYear   Int
  importedAt       DateTime        @default(now())
  activated        Boolean         @default(false)
  userId           String?         @unique
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentProfile   StudentProfile?

  @@index([email])
  @@index([enrollmentNumber])
}

model StudentProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorizedStudentId String             @unique
  authorizedStudent   AuthorizedStudent  @relation(fields: [authorizedStudentId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  practiceSessions    PracticeSession[]
  attempts            QuestionAttempt[]
  skillMasteries      SkillMastery[]
  learningHistories   LearningHistory[]
  counsellorAssignments CounsellorAssignment[]
  aiConversations     AIConversation[]
  misconceptions      StudentMisconception[]
  spacedSchedules     SpacedRepetitionSchedule[]
  assessmentSubmissions AssessmentSubmission[]
  atRiskAlerts        AtRiskAlert[]
  proctoringSessions  ProctoringSession[]
  placementProfile    StudentPlacementProfile?
  codeSubmissions     CodeSubmission[]
  questionDisputes    QuestionDispute[]
  notifications       StudentNotification[]
}

model FacultyProfile {
  id           String       @id @default(uuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String?      @unique
  departmentId String?
  courseId     String?
  course       Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  assessments  Assessment[]
  reviewedDisputes QuestionDispute[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Question {
  id           String             @id @default(uuid())
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topicId      String
  topic        Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdBy    String?
  type         QuestionType       @default(MCQ_SINGLE)
  difficulty   QuestionDifficulty @default(MEDIUM)
  questionText String             @db.Text
  explanation  String             @db.Text
  sourceType   String             @default("MANUAL")
  status       QuestionStatus     @default(APPROVED)
  options      QuestionOption[]
  attempts     QuestionAttempt[]
  aiConversations AIConversation[]
  assessmentQuestions AssessmentQuestion[]
  submissionAnswers   SubmissionAnswer[]
  coMappings          QuestionCOMapping[]
  disputes            QuestionDispute[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([courseId, topicId, difficulty])
}

model QuestionOption {
  id         String            @id @default(uuid())
  questionId String
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String            @db.Text
  isCorrect  Boolean           @default(false)
  order           Int               @default(0)
  misconceptionId String?
  misconception   Misconception?    @relation(fields: [misconceptionId], references: [id], onDelete: SetNull)
  attempts          QuestionAttempt[]
  submissionAnswers SubmissionAnswer[]
}

model PracticeSession {
  id                 String             @id @default(uuid())
  studentId          String
  student            StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topicId            String?
  difficulty         QuestionDifficulty?
  startedAt          DateTime           @default(now())
  completedAt        DateTime?
  questionsAttempted Int                @default(0)
  correctAnswers     Int                @default(0)
  attempts           QuestionAttempt[]

  @@index([studentId, courseId])
}

model QuestionAttempt {
  id                 String             @id @default(uuid())
  studentId          String
  student            StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId         String
  question           Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  practiceSessionId  String?
  practiceSession    PracticeSession?   @relation(fields: [practiceSessionId], references: [id], onDelete: SetNull)
  selectedOptionId   String?
  selectedOption     QuestionOption?    @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  isCorrect          Boolean
  timeTakenSeconds   Int                @default(0)
  attemptNumber      Int                @default(1)
  hintUsed           Boolean            @default(false)
  difficultyAtAttempt QuestionDifficulty @default(MEDIUM)
  createdAt          DateTime           @default(now())

  @@index([studentId, questionId])
  @@index([studentId, createdAt])
}

model SkillMastery {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId        String
  topic          Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  masteryScore   Float          @default(0.0)
  attemptCount   Int            @default(0)
  correctCount   Int            @default(0)
  lastPracticedAt DateTime      @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([studentId, topicId])
  @@index([studentId])
}

model LearningHistory {
  id           String                @id @default(uuid())
  studentId    String
  student      StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId      String
  topic        Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  masteryScore Float
  recordedAt   DateTime              @default(now())
  reason       LearningHistoryReason @default(PRACTICE_ATTEMPT)

  @@index([studentId, recordedAt])
  @@index([studentId, topicId])
}

model CounsellorAssignment {
  id           String         @id @default(uuid())
  counsellorId String
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedAt   DateTime       @default(now())

  @@unique([counsellorId, studentId])
}

model LearningResource {
  id               String       @id @default(uuid())
  topicId          String
  topic            Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title            String
  description      String       @db.Text
  resourceType     ResourceType @default(LECTURE_SLIDE)
  url              String
  author           String?
  estimatedMinutes Int          @default(15)
  keyConcepts      String       @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([topicId, resourceType])
}

model AIConversation {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  topicId    String
  topic      Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  messages   AIMessage[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([studentId, topicId])
}

model AIMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   AIConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole      @default(ASSISTANT)
  actionType     SocraticActionType @default(SOCRATIC_PROMPT)
  content        String             @db.Text
  metadata       String?            @db.Text
  createdAt      DateTime           @default(now())

  @@index([conversationId])
}

enum MisconceptionCategory {
  CONCEPTUAL_CONFUSION
  OFF_BY_ONE_ERROR
  COMPLEXITY_MISCALCULATION
  BOUNDARY_EDGE_CASE
  POINTER_REFERENCE_CONFUSION
  SYNTAX_SEMANTICS_OVERLOOK
}

enum SpacedRepetitionStatus {
  DUE
  UPCOMING
  MASTERED
}

model Misconception {
  id                 String                @id @default(uuid())
  code               String                @unique
  title              String
  description        String                @db.Text
  category           MisconceptionCategory @default(CONCEPTUAL_CONFUSION)
  remediationAdvice  String                @db.Text
  topicId            String
  topic              Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  distractorOptions  QuestionOption[]
  studentOccurrences StudentMisconception[]
  createdAt          DateTime              @default(now())

  @@index([topicId, category])
}

model StudentMisconception {
  id              String        @id @default(uuid())
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  misconceptionId String
  misconception   Misconception @relation(fields: [misconceptionId], references: [id], onDelete: Cascade)
  occurrenceCount Int           @default(1)
  lastDetectedAt  DateTime      @default(now())
  resolved        Boolean       @default(false)
  resolvedAt      DateTime?

  @@unique([studentId, misconceptionId])
  @@index([studentId, resolved])
}

model SpacedRepetitionSchedule {
  id               String                 @id @default(uuid())
  studentId        String
  student          StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId          String
  topic            Topic                  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  intervalDays     Int                    @default(1)
  easeFactor       Float                  @default(2.5)
  repetitionNumber Int                    @default(0)
  nextReviewDate   DateTime
  lastReviewedDate DateTime?
  status           SpacedRepetitionStatus @default(DUE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([studentId, topicId])
  @@index([studentId, status, nextReviewDate])
}

enum AssessmentType {
  QUIZ
  UNIT_TEST
  MID_TERM
  FINAL_EXAM
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

model Assessment {
  id                 String               @id @default(uuid())
  title              String
  description        String?              @db.Text
  code               String               @unique
  courseId           String
  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  facultyId          String?
  faculty            FacultyProfile?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  type               AssessmentType       @default(QUIZ)
  status             AssessmentStatus     @default(PUBLISHED)
  durationMinutes    Int                  @default(30)
  totalMarks         Float                @default(100.0)
  passingMarks       Float                @default(40.0)
  totalQuestions     Int                  @default(5)
  randomizeQuestions Boolean              @default(true)
  allowedAttempts    Int                  @default(2)
  scheduledStartTime DateTime?
  scheduledEndTime   DateTime?
  questions          AssessmentQuestion[]
  submissions        AssessmentSubmission[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([courseId, status])
}

model AssessmentQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  points       Float      @default(20.0)
  order        Int        @default(0)

  @@unique([assessmentId, questionId])
  @@index([assessmentId, order])
}

model AssessmentSubmission {
  id                 String             @id @default(uuid())
  assessmentId       String
  assessment         Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId          String
  student            StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber      Int                @default(1)
  startedAt          DateTime           @default(now())
  submittedAt        DateTime?
  status             SubmissionStatus   @default(IN_PROGRESS)
  totalScore         Float              @default(0.0)
  percentage         Float              @default(0.0)
  passed             Boolean            @default(false)
  answers            SubmissionAnswer[]
  proctoringSession  ProctoringSession?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([assessmentId, studentId, status])
}

model SubmissionAnswer {
  id               String               @id @default(uuid())
  submissionId     String
  submission       AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption?      @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  isCorrect        Boolean              @default(false)
  pointsAwarded    Float                @default(0.0)
  timeSpentSeconds Int                  @default(0)

  @@index([submissionId, questionId])
}

enum AIGenerationStatus {
  STAGED
  APPROVED
  REJECTED
  EXPORTED
}

enum BloomTaxonomyLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

model AIGeneratedQuestion {
  id                 String             @id @default(uuid())
  topicId            String
  topic              Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  promptQuery        String?            @db.Text
  bloomLevel         BloomTaxonomyLevel @default(APPLY)
  difficulty         QuestionDifficulty @default(MEDIUM)
  questionText       String             @db.Text
  explanation        String             @db.Text
  optionsJson        String             @db.Text
  status             AIGenerationStatus @default(STAGED)
  facultyFeedback    String?            @db.Text
  reviewedBy         String?
  reviewedAt         DateTime?
  approvedQuestionId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([topicId, status])
}

enum DocumentType {
  SYLLABUS
  LECTURE_NOTES
  PRESENTATION_SLIDES
  REFERENCE_TEXT
}

enum DocumentProcessingStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

model CourseDocument {
  id           String                   @id @default(uuid())
  courseId     String
  course       Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  fileName     String
  fileType     String                   @default("PDF")
  documentType DocumentType             @default(LECTURE_NOTES)
  fileSizeKb   Int                      @default(0)
  rawText      String                   @db.LongText
  status       DocumentProcessingStatus @default(INDEXED)
  chunkCount   Int                      @default(0)
  uploadedBy   String?
  chunks       DocumentChunk[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([courseId, documentType])
}

model DocumentChunk {
  id              String         @id @default(uuid())
  documentId      String
  document        CourseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex      Int            @default(0)
  content         String         @db.Text
  tokenCount      Int            @default(0)
  vectorEmbedding String?        @db.Text
  topicKeywords   String?
  createdAt       DateTime       @default(now())

  @@index([documentId, chunkIndex])
}

enum AtRiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InterventionStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model ProgramOutcome {
  id             String            @id @default(uuid())
  departmentId   String
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code           String            // e.g. "PO1", "PO2"
  description    String            @db.Text
  nbaCategory    String            @default("Engineering Knowledge")
  courseOutcomes CourseOutcomePO[]
  createdAt      DateTime          @default(now())

  @@unique([departmentId, code])
}

model CourseOutcome {
  id               String              @id @default(uuid())
  courseId         String
  course           Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code             String              // e.g. "CO1", "CO2"
  description      String              @db.Text
  targetAttainment Float               @default(0.70)
  actualAttainment Float               @default(0.0)
  programOutcomes  CourseOutcomePO[]
  questionMappings QuestionCOMapping[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([courseId, code])
}

model CourseOutcomePO {
  id               String         @id @default(uuid())
  courseOutcomeId  String
  courseOutcome    CourseOutcome  @relation(fields: [courseOutcomeId], references: [id], onDelete: Cascade)
  programOutcomeId String
  programOutcome   ProgramOutcome @relation(fields: [programOutcomeId], references: [id], onDelete: Cascade)
  correlationLevel Int            @default(2) // 1: Low, 2: Moderate, 3: Substantial (NBA/NAAC standard)

  @@unique([courseOutcomeId, programOutcomeId])
}

model QuestionCOMapping {
  id              String        @id @default(uuid())
  questionId      String
  question        Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  courseOutcomeId String
  courseOutcome   CourseOutcome @relation(fields: [courseOutcomeId], references: [id], onDelete: Cascade)
  weight          Float         @default(1.0)

  @@unique([questionId, courseOutcomeId])
}

model AtRiskAlert {
  id                    String             @id @default(uuid())
  studentId             String
  student               StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  counsellorId          String?
  severity              AtRiskSeverity     @default(MEDIUM)
  status                InterventionStatus @default(PENDING)
  triggerReason         String             @db.Text
  suggestedIntervention String             @db.Text
  actionNotes           String?            @db.Text
  resolvedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([studentId, severity, status])
}

// ==============================================================================
// Phase 9: AI-Assisted Assessment Integrity / Proctoring
// ==============================================================================

enum ProctoringViolationType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  NO_FACE
  MULTIPLE_FACES
  IDENTITY_MISMATCH
  CAMERA_DISABLED
  AUDIO_ANOMALY
}

enum ProctoringSessionStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  FLAGGED
  INVALIDATED
}

enum IntegrityFlagSeverity {
  LOW
  MEDIUM
  HIGH
  SEVERE
}

model ProctoringSession {
  id                     String                  @id @default(uuid())
  submissionId           String                  @unique
  submission             AssessmentSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  studentId              String
  student                StudentProfile          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status                 ProctoringSessionStatus @default(IN_PROGRESS)
  faceEnrollmentVerified Boolean                 @default(false)
  enrolledAt             DateTime?
  startedAt              DateTime                @default(now())
  completedAt            DateTime?
  trustScore             Float                   @default(100.0)
  violationsCount        Int                     @default(0)
  invigilatorNotes       String?                 @db.Text
  violations             ProctoringViolation[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([studentId, status])
}

model ProctoringViolation {
  id         String                  @id @default(uuid())
  sessionId  String
  session    ProctoringSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type       ProctoringViolationType
  severity   IntegrityFlagSeverity   @default(MEDIUM)
  confidence Float                   @default(0.95)
  timestamp  DateTime                @default(now())
  details    String?                 @db.Text
  resolved   Boolean                 @default(false)

  @@index([sessionId, type, severity])
}

// ==============================================================================
// Phase 10: Career & Placement Readiness
// ==============================================================================

enum CareerRoleType {
  SDE
  DATA_ANALYST
  ML_ENGINEER
  CYBERSECURITY_ANALYST
  CLOUD_DEVOPS
  GATE_CS
}

model CareerRoleBenchmark {
  id             String         @id @default(uuid())
  roleType       CareerRoleType @unique
  title          String
  description    String         @db.Text
  targetMastery  Float          @default(80.0)
  requiredSkills String         @db.Text // JSON: array of { topicName: string, minMastery: number, weight: number }
  salaryRange    String?
  hiringPartners String?        // e.g. "Google, Amazon, Microsoft, Infosys"
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model StudentPlacementProfile {
  id                    String         @id @default(uuid())
  studentId             String         @unique
  student               StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  targetRole            CareerRoleType @default(SDE)
  overallReadinessScore Float          @default(0.0) // 0 - 100%
  verifiedSkillsCount   Int            @default(0)
  skillGapsCount        Int            @default(0)
  lastAssessedAt        DateTime       @default(now())
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model PlacementMockExam {
  id              String             @id @default(uuid())
  roleType        CareerRoleType     @default(SDE)
  companyProfile  String             // e.g. "Google Tier-1", "Amazon SDE", "TCS Digital"
  title           String
  description     String             @db.Text
  totalQuestions  Int                @default(10)
  durationMinutes Int                @default(45)
  passingScore    Float              @default(70.0)
  difficulty      QuestionDifficulty @default(HARD)
  createdAt       DateTime           @default(now())
}

// ==============================================================================
// Phase 11: In-Browser Coding Assessment Engine & Automated Code Judge
// ==============================================================================

enum ProgrammingLanguage {
  PYTHON
  CPP
  JAVA
  JAVASCRIPT
}

enum JudgeSubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
}

model CodingProblem {
  id              String             @id @default(uuid())
  slug            String             @unique
  title           String
  description     String             @db.Text
  difficulty      QuestionDifficulty @default(MEDIUM)
  starterCodes    String             @db.Text // JSON: { "PYTHON": "...", "CPP": "...", ... }
  constraints     String             @db.Text
  hints           String?            @db.Text // JSON: array of strings
  tags            String?            // e.g. "Array, Hash Table, Two Pointers"
  courseId        String?
  course          Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  testCases       TestCase[]
  submissions     CodeSubmission[]
  plagiarismScans PlagiarismScan[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([difficulty])
}

model TestCase {
  id               String        @id @default(uuid())
  problemId        String
  problem          CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input            String        @db.Text
  expectedOutput   String        @db.Text
  isHidden         Boolean       @default(false)
  explanation      String?       @db.Text
  timeLimitMs      Int           @default(2000)
  memoryLimitMb    Int           @default(128)
  order            Int           @default(0)
  createdAt        DateTime      @default(now())

  @@index([problemId])
}

model CodeSubmission {
  id                    String                @id @default(uuid())
  studentId             String
  student               StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  problemId             String
  problem               CodingProblem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language              ProgrammingLanguage   @default(PYTHON)
  sourceCode            String                @db.Text
  status                JudgeSubmissionStatus @default(PENDING)
  executionTimeMs       Int                   @default(0)
  memoryUsedKb          Int                   @default(0)
  testCasesPassed       Int                   @default(0)
  totalTestCases        Int                   @default(0)
  judgeDetails          String?               @db.Text // JSON with per-testcase execution output
  matchesAsSubmissionA  PlagiarismMatch[]     @relation("SubmissionA")
  matchesAsSubmissionB  PlagiarismMatch[]     @relation("SubmissionB")
  createdAt             DateTime              @default(now())

  @@index([studentId, problemId])
  @@index([status])
}

// ==============================================================================
// Phase 12: Code Plagiarism Detection & Structural AST Similarity Engine
// ==============================================================================

enum PlagiarismScanStatus {
  PENDING
  SCANNING
  COMPLETED
  FAILED
}

enum PlagiarismVerdict {
  SUSPICIOUS
  FLAGGED
  CLEARED
  PENALIZED
}

model PlagiarismScan {
  id                      String               @id @default(uuid())
  problemId               String
  problem                 CodingProblem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  facultyId               String?
  status                  PlagiarismScanStatus @default(COMPLETED)
  threshold               Float                @default(70.0) // 0-100%
  totalSubmissionsScanned Int                  @default(0)
  flaggedPairsCount       Int                  @default(0)
  matches                 PlagiarismMatch[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([problemId])
}

model PlagiarismMatch {
  id                 String            @id @default(uuid())
  scanId             String
  scan               PlagiarismScan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  submissionAId      String
  submissionA        CodeSubmission    @relation("SubmissionA", fields: [submissionAId], references: [id], onDelete: Cascade)
  submissionBId      String
  submissionB        CodeSubmission    @relation("SubmissionB", fields: [submissionBId], references: [id], onDelete: Cascade)
  similarityScore    Float             @default(0.0) // 0 - 100%
  matchedTokensCount Int               @default(0)
  fingerprintOverlap String?           @db.Text // JSON: array of matching token ranges
  verdict            PlagiarismVerdict @default(SUSPICIOUS)
  facultyNotes       String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([scanId, similarityScore])
}

enum DisputeStatus {
  PENDING
  APPROVED_STUDENT_CORRECT
  REJECTED_AI_CORRECT
}

model QuestionDispute {
  id                String          @id @default(uuid())
  questionId        String
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentId         String
  student           StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  practiceSessionId String?
  selectedOptionId  String?
  reasonCategory    String          @default("WRONG_ANSWER")
  studentComment    String          @db.Text
  status            DisputeStatus   @default(PENDING)
  facultyId         String?
  faculty           FacultyProfile? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  facultyRemarks    String?         @db.Text
  resolvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([questionId])
  @@index([studentId])
  @@index([status])
}

model StudentNotification {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  message   String         @db.Text
  type      String         @default("DISPUTE_UPDATE")
  read      Boolean        @default(false)
  metadata  String?        @db.Text
  createdAt DateTime       @default(now())

  @@index([studentId, read])
}
